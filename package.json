{
  "name": "omnilog-hub",
  "version": "2.2.0",
  "description": "Plataforma integrada de gestão logística com clientes web e desktop, API REST, MySQL e documentação acadêmica",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:check": "node scripts/check-db.js",
    "seed:admin": "node scripts/create-admin.js",
    "test": "jest --runInBand",
    "desktop": "electron electron/main.js",
    "test:coverage": "jest --runInBand --coverage",
    "admin:check": "node scripts/check-admin.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore:test": "node scripts/restore-db.js",
    "desktop:build": "mvn -f desktop-java/pom.xml clean package",
    "desktop:run": "java -jar desktop-java/target/omnilog-desktop-1.0.0.jar"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "nodemon": "^3.1.9",
    "electron": "^42.4.0"
  }
}
