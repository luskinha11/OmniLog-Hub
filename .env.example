PORT=3000
NODE_ENV=development

# MySQL 8.4 instalado neste computador
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=COLOQUE_A_SENHA_DO_ROOT_AQUI
DB_NAME=omnilog_hub

# Gere uma chave longa e aleatória para a sessão antes de publicar o sistema
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Conta administrativa inicial (troque a senha antes de executar seed:admin)
ADMIN_EMAIL=admin@omnilog.local
ADMIN_PASSWORD=TroqueEstaSenha123!

# SMTP opcional para recuperação de senha por e-mail.
# Para Gmail, use uma senha de app, nunca a senha normal da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESET_TOKEN_SECRET=troque-por-outra-chave-aleatoria-longa
